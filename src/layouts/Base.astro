---
import '../styles/global.css';
import '@fontsource-variable/raleway';
import '@fontsource-variable/albert-sans';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Matthew Ranford | Web Producer, CMS Specialist, & Frontend Developer | Gold Coast',
  description = 'Web Producer, CMS Specialist, & Frontend Developer based on the Gold Coast. Experienced in Duda, WordPress, Webflow, Shopify, and frontend development — delivering and maintaining client websites at scale.',
} = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen bg-ink text-white">
    <Header />
    <main>
      <slot />
    </main>

    <script>
      import '../scripts/animations.ts';
    </script>
  </body>
</html>