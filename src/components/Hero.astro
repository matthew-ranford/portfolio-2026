---
import Container from './Container.astro';
import { Icon } from 'astro-icon/components';

const contacts = [
  { icon: 'lucide:mail', label: 'matt.ranford16@gmail.com', href: 'mailto:matt.ranford16@gmail.com' },
  { icon: 'tabler:brand-github', label: 'github.com/matthew-ranford', href: 'https://github.com/matthew-ranford' },
  { icon: 'tabler:brand-linkedin', label: 'linkedin.com/in/matthew-ranford', href: 'https://www.linkedin.com/in/matthew-ranford-23b759261/' },
  { icon: 'lucide:map-pin', label: 'Bilinga, Gold Coast', href: 'https://maps.app.goo.gl/kaeptj3vEAzN3Y4z8', alwaysShowLabel: true },
];

const shadow = '[text-shadow:0_3px_5px_rgb(0_0_0/0.3)]';
---

<section id="home" class="relative flex min-h-svh items-center overflow-hidden">
  <img
    src="/images/matt-hero.webp"
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />

  <Container class="py-32">
    <h1 class:list={['font-heading text-[22px] font-semibold text-coral md:text-[35px]', shadow]}>
      Web Producer | CMS Specialist | Frontend Developer.
    </h1>
    <p class:list={['font-heading text-[40px] font-bold leading-tight text-white md:text-[61px]', shadow]}>
      Matthew Ranford.
    </p>

    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
      {contacts.map((item) => {
        const isExternal = item.href.startsWith('http');
        return (
          <li>
            <a
              href={item.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              class:list={['flex items-center gap-3 text-white/90 hover:text-white', shadow]}
            >
              <Icon name={item.icon} class="size-8 shrink-0 text-coral" aria-hidden="true" />
              <span class:list={['text-sm', !item.alwaysShowLabel && 'max-md:sr-only']}>
                {item.label}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </Container>
</section>