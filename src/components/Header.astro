---
import Container from './Container.astro';

const links = [
  { href: '#home', label: 'Home' },
  { href: '#summary', label: 'Summary' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#links', label: 'Links' },
];
---

<header class="absolute inset-x-0 top-0 z-50">
  <Container class="flex items-center justify-between py-6">
    <a href="/" class="border-l border-white/60 pl-3 leading-tight text-white">
      <span class="block font-heading text-xl font-semibold">Matthew Ranford</span>
      <span class="block text-xs">Web Design &amp; Development</span>
    </a>

    <a
      href="/cv.pdf"
      class="rounded-full bg-linear-to-r from-coral to-ember px-6 py-3 text-sm font-semibold text-white"
    >
      Download CV
    </a>
  </Container>
</header>

<nav aria-label="Main" class="fixed bottom-6 left-1/2 z-50 -translate-x-1/2">
  <ul
    class="flex items-center gap-1 rounded-full border border-white/15 bg-white/10 p-1.5 shadow-lg backdrop-blur-xl backdrop-saturate-150"
  >
    {links.map((link) => (
   <li>
  <a
    href={link.href}
    data-active={link.href === '#home' ? '' : undefined}
    class="block rounded-full px-4 py-2.5 text-sm font-medium text-white transition-colors duration-300 data-active:bg-white data-active:text-ink"
  >
    {link.label}
  </a>
</li>
    ))}
  </ul>
</nav>